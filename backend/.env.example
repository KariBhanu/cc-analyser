# Copy to .env and fill in. Never commit .env.

# Secret used to sign sessions AND encrypt stored statement passwords.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=dev-insecure-secret-change-me

# Google sign-in (Google Cloud Console -> APIs & Services -> Credentials ->
# OAuth client ID -> Web application). Authorised redirect URI must be exactly:
#   http://localhost:8000/api/auth/callback
# Leave blank to use the built-in DEV_LOGIN button instead (no Google needed).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email delivery for verification codes ────────────────────────────────────
# Gmail: turn on 2-Step Verification, then Security -> App passwords -> Mail.
# Use the 16-character app password (spaces removed) as SMTP_PASSWORD.
# Leave SMTP_HOST blank and codes are printed to the backend log instead of sent,
# which is enough to use the whole signup flow locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SmartCred <you@gmail.com>
SMTP_USE_TLS=true

# ── One-time codes ───────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60

# Email verification always gates login. Phone verification is collected at
# signup but optional to complete, because SMS needs DLT registration in India
# (see backend/app/services/sms.py). Set true once an SMS provider is live.
REQUIRE_PHONE_VERIFICATION=false

# URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# When true, exposes POST /api/auth/dev-login so you can use the app without
# Google configured. Set to false in production.
DEV_LOGIN=true
